// Leadyfy OS - Prisma Database Schema
// Production-grade normalized relational schema for UGC & Digital Marketing Agency SaaS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  OWNER
  ADMIN
  EMPLOYEE
  CLIENT
}

enum EmployeeSubRole {
  SALES
  SCRIPT_WRITER
  SHOOT_MANAGER
  EDITOR
}

enum ClientStatus {
  LEAD
  NEW
  ONBOARDING
  ACTIVE
  ON_HOLD
  COMPLETED
  INACTIVE
}

enum OrderStatus {
  NEW
  ONBOARDING
  IN_PRODUCTION
  PARTIALLY_DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ScriptStatus {
  DRAFT
  ASSIGNED
  IN_REVIEW
  SENT_TO_CLIENT
  REVISION_REQUIRED
  APPROVED
  READY_FOR_SHOOT
}

enum CreatorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
  ON_HOLD
}

enum ShootStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESHOOT_REQUIRED
}

enum PipelineStatus {
  SCRIPT_APPROVED
  SHOOT_PENDING
  RAW_FOOTAGE_RECEIVED
  VIDEO_EDITING
  INTERNAL_QA
  CLIENT_REVIEW
  REVISION
  FINAL_APPROVED
  DELIVERED
}

enum UrgencyStatus {
  NORMAL
  DUE_TOMORROW
  DUE_TODAY
  OVERDUE
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  DONE
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  STRIPE
  CASH
  OTHER
}

enum ExpenseCategory {
  SALARIES
  OFFICE
  STUDIO
  EQUIPMENT
  FUEL
  PAYOUTS
  MARKETING
  MISC
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ACTION_REQUIRED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVAL
  PAYOUT
}

enum AssetType {
  RAW_FOOTAGE
  BRAND_ASSET
  FINAL_VIDEO
  THUMBNAIL
  DOCUMENT
}

enum StorageProvider {
  GOOGLE_DRIVE
  SUPABASE_STORAGE
  S3
  OTHER
}

// ==========================================
// 1. CORE AUTH & IDENTITY
// ==========================================

model User {
  id           String      @id @default(uuid())
  supabaseId   String      @unique @map("supabase_id")
  email        String      @unique
  fullName     String      @map("full_name")
  phone        String?
  role         UserRole    @default(EMPLOYEE)
  avatarUrl    String?     @map("avatar_url")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  employee        Employee?
  client          Client?
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreator")
  authoredFeedback VideoFeedback[] @relation("FeedbackAuthor")
  expensesLogged  Expense[]        @relation("ExpensesLogged")
  notifications   Notification[]
  supportTickets  SupportTicket[]  @relation("TicketCreator")
  activityLogs    ActivityLog[]

  @@index([role])
  @@index([email])
  @@map("users")
}

// ==========================================
// 2. EMPLOYEE PROFILES & SUB-ROLES
// ==========================================

model Employee {
  id               String          @id @default(uuid())
  userId           String          @unique @map("user_id")
  subRole          EmployeeSubRole @map("sub_role")
  salary           Decimal?        @db.Decimal(10, 2)
  joiningDate      DateTime        @default(now()) @map("joining_date")
  department       String          @default("Operations")
  performanceScore Float           @default(100.0) @map("performance_score")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedClients  Client[] @relation("AssignedAccountManager")
  writtenScripts  Script[] @relation("ScriptWriter")
  managedShoots   Shoot[]  @relation("ShootManager")
  assignedVideos  Video[]  @relation("AssignedEditor")

  @@index([subRole])
  @@map("employees")
}

// ==========================================
// 3. CLIENT MANAGEMENT (CANONICAL SCHEMA)
// ==========================================

model Client {
  id                 String       @id @default(uuid())
  userId             String?      @unique @map("user_id")
  clientName         String       @map("client_name")
  companyName        String       @map("company_name") // Canonical naming: companyName -> company_name
  email              String       @unique
  phone              String
  whatsapp           String?
  brandName          String       @map("brand_name")
  industry           String?
  gstTaxId           String?      @map("gst_tax_id")
  assignedEmployeeId String?      @map("assigned_employee_id")
  source             String?      @default("Direct")
  status             ClientStatus @default(NEW)
  brandKitUrl        String?      @map("brand_kit_url")
  notes              String?      @db.Text
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  // Relations
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountManager   Employee?       @relation("AssignedAccountManager", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  orders           Order[]
  scripts          Script[]
  shoots           Shoot[]
  videos           Video[]
  payments         Payment[]
  supportTickets   SupportTicket[]
  assets           Asset[]

  @@index([status])
  @@index([companyName])
  @@index([brandName])
  @@map("clients")
}

// ==========================================
// 4. PACKAGE & ORDER PIPELINE
// ==========================================

model Order {
  id                   String      @id @default(uuid())
  orderNumber          String      @unique @map("order_number")
  clientId             String      @map("client_id")
  packageName          String      @map("package_name")
  contractedVideoCount Int         @default(1) @map("contracted_video_count")
  completedVideoCount  Int         @default(0) @map("completed_video_count")
  deliveredVideoCount  Int         @default(0) @map("delivered_video_count")
  pricing              Decimal     @db.Decimal(12, 2)
  gstRate              Decimal     @default(18.0) @db.Decimal(5, 2) @map("gst_rate")
  totalAmount          Decimal     @db.Decimal(12, 2) @map("total_amount")
  amountReceived       Decimal     @default(0) @db.Decimal(12, 2) @map("amount_received")
  outstandingBalance   Decimal     @db.Decimal(12, 2) @map("outstanding_balance")
  startDate            DateTime    @default(now()) @map("start_date")
  dueDate              DateTime    @map("due_date")
  assignedTeamId       String?     @map("assigned_team_id")
  status               OrderStatus @default(NEW)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  // Relations
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scripts        Script[]
  shoots         Shoot[]
  videos         Video[]
  payments       Payment[]
  creatorPayouts CreatorPayout[]
  assets         Asset[]

  @@index([clientId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

// ==========================================
// 5. MANUAL SCRIPT WORKFLOW (NO AI)
// ==========================================

model Script {
  id             String       @id @default(uuid())
  orderId        String       @map("order_id")
  clientId       String       @map("client_id")
  videoNumber    Int          @default(1) @map("video_number")
  title          String
  writerId       String?      @map("writer_id")
  creatorId      String?      @map("creator_id")
  language       String       @default("English")
  scriptText     String       @db.Text @map("script_text")
  referenceLinks String?      @db.Text @map("reference_links")
  deadline       DateTime?
  revisionCount  Int          @default(0) @map("revision_count")
  status         ScriptStatus @default(DRAFT)
  clientComments String?      @db.Text @map("client_comments")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  order   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  client  Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  writer  Employee? @relation("ScriptWriter", fields: [writerId], references: [id], onDelete: SetNull)
  creator Creator?  @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  videos  Video[]

  @@index([orderId])
  @@index([clientId])
  @@index([status])
  @@map("scripts")
}

// ==========================================
// 6. CREATOR MANAGEMENT HUB & AVAILABILITY
// ==========================================

model Creator {
  id            String        @id @default(uuid())
  name          String
  photoUrl      String?       @map("photo_url")
  gender        String?
  ageGroup      String?       @map("age_group")
  languages     String[]      @default(["English"])
  location      String?
  niches        String[]      @default([])
  demographics  String?
  contactPhone  String        @map("contact_phone")
  contactEmail  String?       @map("contact_email")
  ratesPerVideo Decimal       @db.Decimal(10, 2) @map("rates_per_video")
  bankUpiInfo   String?       @map("bank_upi_info")
  portfolioLinks String[]     @default([]) @map("portfolio_links")
  rating        Float         @default(5.0)
  status        CreatorStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  availabilities CreatorAvailability[]
  scripts        Script[]
  shoots         Shoot[]
  videos         Video[]
  payouts        CreatorPayout[]

  @@index([status])
  @@index([name])
  @@map("creators")
}

model CreatorAvailability {
  id        String             @id @default(uuid())
  creatorId String             @map("creator_id")
  date      DateTime           @db.Date
  timeSlot  String             @map("time_slot") // e.g. "MORNING", "AFTERNOON", "FULL_DAY"
  status    AvailabilityStatus @default(AVAILABLE)
  shootId   String?            @map("shoot_id")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  // Relations
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  shoot   Shoot?  @relation(fields: [shootId], references: [id], onDelete: SetNull)

  // Prevent double booking guardrail
  @@unique([creatorId, date, timeSlot])
  @@index([creatorId, date])
  @@map("creator_availabilities")
}

// ==========================================
// 7. SHOOT MANAGEMENT & LOGISTICS
// ==========================================

model Shoot {
  id                    String      @id @default(uuid())
  shootNumber           String      @unique @map("shoot_number")
  clientId              String      @map("client_id")
  orderId               String      @map("order_id")
  scheduledAt           DateTime    @map("scheduled_at")
  durationHours         Int         @default(4) @map("duration_hours")
  location              String
  assignedCreatorId     String?     @map("assigned_creator_id")
  cameramanName         String?     @map("cameraman_name")
  shootManagerId        String?     @map("shoot_manager_id")
  shootingAssistant     String?     @map("shooting_assistant")
  preShootChecklist     Json        @default("{\"scriptApproved\":false,\"creatorConfirmed\":false,\"locationPermitted\":false,\"productReceived\":false,\"teamBriefed\":false}") @map("pre_shoot_checklist")
  postShootVerification Json        @default("{\"footageUploaded\":false,\"rawIntegrityChecked\":false,\"reshootFlagged\":false}") @map("post_shoot_verification")
  status                ShootStatus @default(SCHEDULED)
  rawFootageFolderUrl   String?     @map("raw_footage_folder_url")
  notes                 String?     @db.Text
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Relations
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator        Creator?              @relation(fields: [assignedCreatorId], references: [id], onDelete: SetNull)
  shootManager   Employee?             @relation("ShootManager", fields: [shootManagerId], references: [id], onDelete: SetNull)
  videos         Video[]
  availabilities CreatorAvailability[]

  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@index([scheduledAt])
  @@map("shoots")
}

// ==========================================
// 8. 9-STEP VIDEO PRODUCTION PIPELINE
// ==========================================

model Video {
  id               String         @id @default(uuid())
  clientId         String         @map("client_id")
  orderId          String         @map("order_id")
  scriptId         String         @map("script_id")
  shootId          String?        @map("shoot_id")
  creatorId        String?        @map("creator_id")
  assignedEditorId String?        @map("assigned_editor_id")
  title            String
  deadline         DateTime
  pipelineStatus   PipelineStatus @default(SCRIPT_APPROVED) @map("pipeline_status")
  urgencyStatus    UrgencyStatus  @default(NORMAL) @map("urgency_status")
  draftVideoUrl    String?        @map("draft_video_url")
  thumbnailUrl     String?        @map("thumbnail_url")
  finalDeliveryUrl String?        @map("final_delivery_url")
  revisionCount    Int            @default(0) @map("revision_count")
  approvedAt       DateTime?      @map("approved_at")
  deliveredAt      DateTime?      @map("delivered_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  script         Script          @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  shoot          Shoot?          @relation(fields: [shootId], references: [id], onDelete: SetNull)
  creator        Creator?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  editor         Employee?       @relation("AssignedEditor", fields: [assignedEditorId], references: [id], onDelete: SetNull)
  feedbackLogs   VideoFeedback[]
  assets         Asset[]
  creatorPayouts CreatorPayout[]

  @@index([clientId])
  @@index([orderId])
  @@index([pipelineStatus])
  @@index([urgencyStatus])
  @@index([assignedEditorId])
  @@map("videos")
}

// ==========================================
// 9. VIDEO FEEDBACK & TIMESTAMPED REVIEWS
// ==========================================

model VideoFeedback {
  id               String   @id @default(uuid())
  videoId          String   @map("video_id")
  authorUserId     String   @map("author_user_id")
  isClientFeedback Boolean  @default(false) @map("is_client_feedback")
  timestampInVideo Float    @default(0.0) @map("timestamp_in_video") // in seconds
  comment          String   @db.Text
  resolved         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  video  Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author User  @relation("FeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("video_feedbacks")
}

// ==========================================
// 10. INTERNAL TASK MANAGEMENT
// ==========================================

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  assigneeId  String?      @map("assignee_id")
  creatorId   String       @map("creator_id")
  priority    TaskPriority @default(MEDIUM)
  deadline    DateTime?
  status      TaskStatus   @default(TO_DO)
  attachments Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User  @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

// ==========================================
// 11. FINANCIALS: CLIENT PAYMENTS & RECEIVABLES
// ==========================================

model Payment {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  clientId       String        @map("client_id")
  orderId        String        @map("order_id")
  invoiceAmount  Decimal       @db.Decimal(12, 2) @map("invoice_amount")
  amountReceived Decimal       @default(0) @db.Decimal(12, 2) @map("amount_received")
  pendingBalance Decimal       @db.Decimal(12, 2) @map("pending_balance")
  paymentDate    DateTime?     @map("payment_date")
  paymentMethod  PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  transactionRef String?       @map("transaction_ref")
  status         PaymentStatus @default(UNPAID)
  receiptUrl     String?       @map("receipt_url")
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ==========================================
// 12. FINANCIALS: AGENCY EXPENSES
// ==========================================

model Expense {
  id             String          @id @default(uuid())
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  loggedByUserId String          @map("logged_by_user_id")
  expenseDate    DateTime        @default(now()) @map("expense_date")
  receiptFileUrl String?         @map("receipt_file_url")
  description    String          @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  loggedBy User @relation("ExpensesLogged", fields: [loggedByUserId], references: [id], onDelete: Restrict)

  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

// ==========================================
// 13. FINANCIALS: CREATOR PAYOUTS
// ==========================================

model CreatorPayout {
  id                   String       @id @default(uuid())
  creatorId            String       @map("creator_id")
  orderId              String       @map("order_id")
  videoId              String?      @map("video_id")
  videoCount           Int          @default(1) @map("video_count")
  contractedRate       Decimal      @db.Decimal(10, 2) @map("contracted_rate")
  totalPayoutAmount    Decimal      @db.Decimal(12, 2) @map("total_payout_amount")
  paymentDate          DateTime?    @map("payment_date")
  transactionReference String?      @map("transaction_reference")
  status               PayoutStatus @default(PENDING)
  notes                String?      @db.Text
  paidAt               DateTime?    @map("paid_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relations
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  // Guard against duplicate payouts
  @@index([creatorId])
  @@index([orderId])
  @@index([status])
  @@map("creator_payouts")
}

// ==========================================
// 14. NOTIFICATIONS
// ==========================================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  linkUrl   String?          @map("link_url")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ==========================================
// 15. CLIENT SUPPORT TICKETS
// ==========================================

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique @map("ticket_number")
  clientId     String         @map("client_id")
  createdById  String         @map("created_by_id")
  subject      String
  description  String         @db.Text
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("support_tickets")
}

// ==========================================
// 16. SYSTEM ACTIVITY AUDIT LOGS
// ==========================================

model ActivityLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==========================================
// 17. DIGITAL ASSETS & ATTACHMENTS
// ==========================================

model Asset {
  id          String          @id @default(uuid())
  clientId    String          @map("client_id")
  orderId     String?         @map("order_id")
  videoId     String?         @map("video_id")
  name        String
  assetType   AssetType       @map("asset_type")
  fileSize    Int             @default(0) @map("file_size") // in bytes
  mimeType    String          @default("application/octet-stream") @map("mime_type")
  storageUrl  String          @map("storage_url")
  provider    StorageProvider @default(GOOGLE_DRIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  video  Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([orderId])
  @@index([assetType])
  @@map("assets")
}
