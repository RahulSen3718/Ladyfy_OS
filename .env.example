# PostgreSQL Connection String (Direct or pooled URL from Supabase/Managed Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadyfy_os?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/leadyfy_os?schema=public"

# Supabase Auth & Project Keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Next.js App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Storage / Google Drive Integration (Optional Storage provider keys)
STORAGE_PROVIDER="SUPABASE_STORAGE" # Options: GOOGLE_DRIVE, SUPABASE_STORAGE, S3
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
